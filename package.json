{
  "name": "inkgist",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:node": "node -e \"process.env.NITRO_PRESET='node-server'; require('child_process').execSync('npx nuxt build', {stdio: 'inherit', env: process.env})\"",
    "build:release": "node scripts/build-release.js",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "sync": "git pull --ff-only origin main",
    "postinstall": "nuxt prepare",
    "test": "node --experimental-strip-types tests/test-suite.mjs"
  },
  "dependencies": {
    "defuddle": "^0.19.2",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "nuxt": "^4.5.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5"
  }
}
